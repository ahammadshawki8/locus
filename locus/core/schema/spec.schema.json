{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locus.local/schema/spec.schema.json",
  "title": "Locus request spec",
  "description": "Written by the intake agent to requests/<iid>/spec.json. See docs/contracts.md §1. Cross-field checks (domain.min < domain.max, profile exists) live in core/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "graph", "mark", "labels", "profileId"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "requestId": {
      "description": "GitLab issue IID. 0 is reserved for local examples.",
      "type": "integer",
      "minimum": 0
    },
    "graph": { "$ref": "#/$defs/polynomial" },
    "mark": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["vertex", "turning-points", "y-intercept", "x-intercepts", "x-intercept+", "x-intercept-"]
      }
    },
    "labels": { "enum": ["braille-grade1"] },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$" }
  },
  "$defs": {
    "bounded": { "type": "number", "minimum": -100, "maximum": 100 },
    "polynomial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coeffs", "domain"],
      "properties": {
        "type": { "const": "polynomial" },
        "coeffs": {
          "description": "Highest degree first: [a, b, c, d] means y = a*x^3 + b*x^2 + c*x + d. Degree <= 3.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/bounded" }
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/bounded" },
            "max": { "$ref": "#/$defs/bounded" }
          }
        }
      }
    }
  }
}
